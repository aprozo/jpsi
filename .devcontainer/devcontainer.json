{
    "name": "J/psi interactive lecture",
    "image": "ghcr.io/aprozo/jpsi:latest",
    "hostRequirements": { "cpus": 2, "memory": "8gb", "storage": "32gb" },
    "waitFor": "postCreateCommand",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-toolsai.jupyter",
                "ms-python.python",
                "albertopdrf.root-file-viewer"
            ],
            "settings": {
                "jupyter.askForKernelRestart": false
            }
        }
    },
    "postCreateCommand": "python3 -c 'import ROOT, pythia8mc; print(\"ROOT\", ROOT.gROOT.GetVersion(), \"and PYTHIA ready\")'"
}
